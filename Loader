-- ====================
local function findPart(partName)
    local part = nil
    for _, obj in pairs(workspace:GetDescendants()) do
        if obj:IsA("BasePart") and obj.Name == partName then
            part = obj
            break
        end
    end
    if not part then
        for _, service in pairs(game:GetChildren()) do
            if service:IsA("Service") and service ~= workspace then
                for _, obj in pairs(service:GetDescendants()) do
                    if obj:IsA("BasePart") and obj.Name == partName then
                        part = obj
                        break
                    end
                end
            end
            if part then break end
        end
    end
    return part
end

local function teleportToPart(partName)
    local part = findPart(partName)
    if not part then
        status.Text = "Парт не найден: " .. partName
        return false
    end
    local character = player.Character
    if not character then
        status.Text = "Персонаж не найден"
        return false
    end
    local humanoidRootPart = character:FindFirstChild("HumanoidRootPart")
    if not humanoidRootPart then
        status.Text = "HumanoidRootPart не найден"
        return false
    end
    humanoidRootPart.CFrame = part.CFrame + Vector3.new(0, 2, 0)
    status.Text = "Телепорт к: " .. partName
    return true
end

local function functionA()
    status.Text = "Телепорт к " .. firstPartName .. "..."
    local success = teleportToPart(firstPartName)
    if success then
        task.wait(0.7)
        status.Text = "Телепорт к " .. secondPartName .. "..."
        teleportToPart(secondPartName)
    end
end

local function toggleCycle()
    if isLooping then
        isLooping = false
        status.Text = "Цикл остановлен"
        cycleToggle.Text = "Цикл: ВЫКЛ"
        TweenService:Create(cycleToggle, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(180, 180, 185),
            TextColor3 = Color3.fromRGB(50, 50, 55)
        }):Play()
    else
        isLooping = true
        status.Text = "Запущен цикл (1 сек)"
        cycleToggle.Text = "Цикл: ВКЛ"
        TweenService:Create(cycleToggle, TweenInfo.new(0.2), {
            BackgroundColor3 = Color3.fromRGB(60, 160, 60),
            TextColor3 = Color3.fromRGB(255, 255, 255)
        }):Play()
        spawn(function()
            while isLooping do
                functionA()
                if isLooping then
                    task.wait(1)
                end
            end
        end)
    end
end

